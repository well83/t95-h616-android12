+        bit = BIT(sta_priv_dat->sta_idx);
+        priv_vif->sta_asleep_mask &= ~bit;
+#ifdef SSV_SUPPORT_HAL
+        spin_unlock_irqrestore(&sc->ps_state_lock, flags);
+        HAL_DEL_FW_WSID(sc, sta, sta_info);
+        spin_lock_irqsave(&sc->ps_state_lock, flags);
