+        return -1;
+    }
+    if (ssv6xxx_chk_usb_speed(glue) == USB_SPEED_HIGH)
+        glue->p_wlan_data->disable_usb_acc(glue->p_wlan_data->usb_param, epnum);
+    return 0;
+}
