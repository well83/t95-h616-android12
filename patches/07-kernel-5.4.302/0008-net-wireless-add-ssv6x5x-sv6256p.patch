+                SMAC_REG_READ(sc->sh, 0xce0100a4, &regval);
+                dev_dbg(sc->dev, "0xce0100a4 [%x]\n",regval);
+                SMAC_REG_READ(sc->sh, ADR_DPLL_DIVIDER_REGISTER, &regval);
