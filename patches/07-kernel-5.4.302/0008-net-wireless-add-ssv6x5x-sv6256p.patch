+    struct ssv6xxx_b_cca_control adjust_cci[] = {
+        {0, 43, 0x00162000, 0x20400080},
+        {40, 48, 0x00161000, 0x20400080},
+        {45, 53, 0x00160800, 0x20400080},
+        {50, 63, 0x00160400, 0x20400080},
