+    SMAC_REG_SET_BITS_CHECK(sh, ADR_PHY_EN_1, (0 << RG_PHY_MD_EN_SFT),
+                            RG_PHY_MD_EN_MSK, exit);
+    SMAC_REG_WRITE_CHECK(sh, ADR_BRG_SW_RST, 1 << MAC_SW_RST_SFT, exit);
+    do {
+        SMAC_REG_READ_CHECK(sh, ADR_BRG_SW_RST, & regval, exit);
