+static void ssv6006c_store_wep_key(struct ssv_softc *sc, struct ssv_vif_priv_data *vif_priv,
+                                   struct ssv_sta_priv_data *sta_priv, enum SSV_CIPHER_E cipher, struct ieee80211_key_conf *key)
