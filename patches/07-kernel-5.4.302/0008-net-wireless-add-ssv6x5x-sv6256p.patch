+                         ((u32)(sh->tx_desc_len) << TX_INFO_SIZE_SFT) |
+                         ((u32)(sh->rx_desc_len) << RX_INFO_SIZE_SFT) |
+                         ((u32)(sh->rx_pinfo_pad) << RX_LAST_PHY_SIZE_SFT ),
