+static void ssv6006c_fill_beacon(struct ssv_softc *sc, u32 regaddr, struct sk_buff *skb)
+{
+    u8 *beacon = skb->data;
+    u32 i, j, val;
+    int size;
+    size = (skb->len)/4;
+    if (0 != (skb->len % 4))
+        size++;
+    for(i = 0; i < size; i++) {
+        val = 0;
+        for ( j = 0; j < 4; j ++) {
+            val += (*beacon++) << j*8;
+        }
+        dbgprint(&sc->cmd_data, sc->log_ctrl, LOG_BEACON, "[%08x] ", val );
+        SMAC_REG_WRITE(sc->sh, regaddr+i*4, val);
+    }
