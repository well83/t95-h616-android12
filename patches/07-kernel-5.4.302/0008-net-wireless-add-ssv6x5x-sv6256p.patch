diff --git a/drivers/net/wireless/ssv6x5x/include/ssv_compat.h b/drivers/net/wireless/ssv6x5x/include/ssv_compat.h
new file mode 100644
index 000000000..7350b68e6
--- /dev/null
+++ b/drivers/net/wireless/ssv6x5x/include/ssv_compat.h
@@ -0,0 +1,42 @@
+/* Strato di compatibilita' per kernel < 6.x (backport 5.4, T95 H616) */
+#ifndef _SSV_COMPAT_H_
+#define _SSV_COMPAT_H_
+#include <linux/version.h>
+#include <linux/types.h>
+
+/* procfs: proc_ops dal 5.6, pde_data minuscolo dal 5.17 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 17, 0)
+#define pde_data(inode) PDE_DATA(inode)
+#endif
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 6, 0)
+#define SSV_PROC_OPS file_operations
+#define SSV_PROC(f) .f
+#else
+#define SSV_PROC_OPS proc_ops
+#define SSV_PROC(f) .proc_##f
+#endif
+
+/* mac80211: assoc/aid in vif->cfg dal 6.0 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 0, 0)
+#define SSV_VIF_CFG(vif) ((vif)->bss_conf)
+typedef u32 ssv_bss_changed_t;
+#else
+#define SSV_VIF_CFG(vif) ((vif)->cfg)
+typedef u64 ssv_bss_changed_t;
+#endif
+
+/* mac80211: ht_cap in sta->deflink dal 5.19 (MLO) */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 19, 0)
+#define SSV_STA_HT_CAP(sta) ((sta)->ht_cap)
+#else
+#define SSV_STA_HT_CAP(sta) ((sta)->deflink.ht_cap)
+#endif
+
+/* usb_driver: campo driver diretto dal 6.8 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 8, 0)
+#define SSV_USB_DRV(d) ((d).drvwrap.driver)
+#else
+#define SSV_USB_DRV(d) ((d).driver)
+#endif
+
+#endif
