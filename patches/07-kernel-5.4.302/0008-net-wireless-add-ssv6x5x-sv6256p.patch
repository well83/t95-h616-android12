diff --git a/drivers/net/wireless/ssv6x5x/ssv6x5x-generic-wlan.c b/drivers/net/wireless/ssv6x5x/ssv6x5x-generic-wlan.c
new file mode 100644
index 000000000..c10c5e6ba
--- /dev/null
+++ b/drivers/net/wireless/ssv6x5x/ssv6x5x-generic-wlan.c
@@ -0,0 +1,94 @@
+/*
+ * Copyright (c) 2015 iComm-semi Ltd.
+ * Glue Allwinner sunxi (T95 H616, kernel 5.4): accensione via sunxi-rf + rescan MMC,
+ * stessa sequenza del driver ssv6158 del BSP Allwinner.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <linux/version.h>
+#include <linux/module.h>
+#include <linux/delay.h>
+#include <linux/printk.h>
+#include <linux/err.h>
+
+extern void sunxi_mmc_rescan_card(unsigned ids);
+extern void sunxi_wlan_set_power(bool on);
+extern int sunxi_wlan_get_bus_index(void);
+
+extern int tu_ssvdevice_init(void);
+extern void tu_ssvdevice_exit(void);
+
+#ifdef CONFIG_SSV_SUPPORT_AES_ASM
+extern int aes_init(void);
+extern void aes_fini(void);
+extern int sha1_mod_init(void);
+extern void sha1_mod_fini(void);
+#endif
+
+static int g_wifidev_registered;
+
+static __init int tu_generic_wifi_init_module(void)
+{
+	int bus;
+	int ret;
+
+	pr_info("ssv6x5x: sunxi glue, power on\n");
+	sunxi_wlan_set_power(1);
+	msleep(100);
+
+	bus = sunxi_wlan_get_bus_index();
+	if (bus < 0) {
+		pr_err("ssv6x5x: get wifi sdc id failed (%d)\n", bus);
+		sunxi_wlan_set_power(0);
+		return -ENODEV;
+	}
+	pr_info("ssv6x5x: sdc_id %d, rescan\n", bus);
+	sunxi_mmc_rescan_card(bus);
+	msleep(150);
+
+#ifdef CONFIG_SSV_SUPPORT_AES_ASM
+	sha1_mod_init();
+	aes_init();
+#endif
+	ret = tu_ssvdevice_init();
+	if (ret) {
+		pr_err("ssv6x5x: ssvdevice init failed (%d)\n", ret);
+#ifdef CONFIG_SSV_SUPPORT_AES_ASM
+		aes_fini();
+		sha1_mod_fini();
+#endif
+		sunxi_mmc_rescan_card(bus);
+		sunxi_wlan_set_power(0);
+		return ret;
+	}
+	g_wifidev_registered = 1;
+	return 0;
+}
+
+static __exit void tu_generic_wifi_exit_module(void)
+{
+	int bus;
+
+	if (g_wifidev_registered) {
+		tu_ssvdevice_exit();
+		g_wifidev_registered = 0;
+	}
+#ifdef CONFIG_SSV_SUPPORT_AES_ASM
+	aes_fini();
+	sha1_mod_fini();
+#endif
+	bus = sunxi_wlan_get_bus_index();
+	if (bus >= 0)
+		sunxi_mmc_rescan_card(bus);
+	sunxi_wlan_set_power(0);
+	pr_info("ssv6x5x: remove card, power off\n");
+}
+
+module_init(tu_generic_wifi_init_module);
+module_exit(tu_generic_wifi_exit_module);
+
+MODULE_LICENSE("Dual BSD/GPL");
