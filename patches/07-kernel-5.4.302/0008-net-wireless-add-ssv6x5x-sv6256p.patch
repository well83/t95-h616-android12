+int ssv6xxx_hci_load_fw_disable_mcu(struct ssv6xxx_hci_ctrl *ctrl_hci)
+{
+    u32 clk_en;
+    if (HCI_REG_WRITE(ctrl_hci, ADR_BRG_SW_RST, 0x0));
