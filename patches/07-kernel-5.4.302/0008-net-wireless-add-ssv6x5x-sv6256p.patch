+               sta_priv_dat->sta_idx, sta_info->hw_wsid, sc->sta_asleep_mask);
+        dev_dbg(sc->dev, "Remove %02x:%02x:%02x:%02x:%02x:%02x to sw_idx=%d, wsid=%d\n",
