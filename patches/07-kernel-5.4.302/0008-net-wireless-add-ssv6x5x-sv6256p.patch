+static void _update_rf_patch(struct ssv_hw *sh, int xtal)
+{
+    dev_dbg(sh->sc->dev, "Set XTAL to %sM", xtal_type[xtal]);
+    SET_RG_DP_XTAL_FREQ(xtal);
+    SET_RG_SX_XTAL_FREQ(xtal);
