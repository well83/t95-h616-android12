+
+#include <linux/version.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0)
+#ifndef FB_EVENT_BLANK
+#define FB_EVENT_BLANK 0x09
+#endif
+#endif
+#include <ssv6200.h>
+#include "dev.h"
+#include "init.h"
+#include "ssv_pm.h"
+#ifdef CONFIG_SSV_SUPPORT_ANDROID
