+                address = 0x80000000 + (id << 16);
+                {
+                    printk("        ");
+                    for (i = 0; i < size; i += 8) {
+                        if(SMAC_REG_READ(sc->sh, address, &value)) { }
+                        printk("\n%08X:%08X", address,value);
+                        address += 4;
+                        for (j = 1; j < 8; j++) {
+                            if(SMAC_REG_READ(sc->sh, address, &value)) { }
+                            printk(" %08X", value);
+                            address += 4;
+                        }
+                    }
+                    printk("\n");
+                }
+            }
+        }
+    }
