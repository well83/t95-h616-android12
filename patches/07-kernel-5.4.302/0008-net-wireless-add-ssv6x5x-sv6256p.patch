+    struct sdio_func *func;
+    if (IS_GLUE_INVALID(glue))
+        return ret;
+    if ( glue != NULL ) {
+        func = dev_to_sdio_func(glue->dev);
+        sdio_claim_host(func);
+        *value = sdio_readb(func, addr, &ret);
+        sdio_release_host(func);
+        CHECK_IO_RET(glue, ret);
+    }
+    return ret;
