+            __s->hci.hci_ops->hci_read_word(__s->hci.hci_ctrl, _r, _v); \
+        })
+#define SMAC_REG_SAFE_WRITE(_s,_r,_v) \
+        ({ \
+            typeof(_s) __s = _s; \
+            __s->hci.hci_ops->hci_safe_write_word(__s->hci.hci_ctrl, _r,_v); \
