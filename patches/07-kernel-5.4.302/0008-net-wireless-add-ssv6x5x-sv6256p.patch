+                             exit);
+        SMAC_REG_WRITE_CHECK(sh, ADR_RX_FLOW_CTRL,
+                             M_ENG_MACRX|(M_ENG_CPU<<4)|(M_ENG_HWHCI<<8), exit);
+        SMAC_REG_WRITE_CHECK(sc->sh, ADR_MRX_FLT_TB0+6*4, (sc->mac_deci_tbl[6]), exit);
+        return ret;
