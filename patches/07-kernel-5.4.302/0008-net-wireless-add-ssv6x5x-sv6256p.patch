+#define SMAC_REG_SET_BITS(_sh,_reg,_set,_clr) \
+({ \
+    int ret; \
+    u32 _regval; \
+    ret = SMAC_REG_READ(_sh, _reg, &_regval); \
+    _regval &= ~(_clr); \
+    _regval |= (_set); \
