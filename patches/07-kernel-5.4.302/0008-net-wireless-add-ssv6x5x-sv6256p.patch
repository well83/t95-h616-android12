+    ssv6006_update_txinfo(sc, skb);
+    if (sc->log_ctrl & LOG_TX_FRAME) {
+        ssv6006_dump_ssv6006_txframe(skb);
+    }
+    if (sc->log_ctrl & LOG_TX_DESC) {
+        printk(" dump tx desciptor after tx add info:\n");
