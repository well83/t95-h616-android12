+            }
+        }
+        fail_cnt++;
+        dev_dbg(sc->dev, "%s(): calibration fail [%d] rounds!!\n",
+               __FUNCTION__, fail_cnt);
+        if(fail_cnt == 100)
+            return -1;
+    } while(ret == 0);
+    return ret;
+}
