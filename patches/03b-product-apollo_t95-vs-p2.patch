--- a/device/softwinner/apollo/apollo_t95.mk
+++ b/device/softwinner/apollo/apollo_t95.mk
@@ -2,10 +2,10 @@
 
 TARGET_BOARD_IC := h618
 PRODUCT_BRAND := Allwinner
-PRODUCT_NAME := apollo_p2
-PRODUCT_DEVICE := apollo-p2
-PRODUCT_BOARD := p2
-PRODUCT_MODEL := orangepizero3
+PRODUCT_NAME := apollo_t95
+PRODUCT_DEVICE := apollo-t95
+PRODUCT_BOARD := t95
+PRODUCT_MODEL := T95_h616
 PRODUCT_MANUFACTURER := Allwinner
 
 PRODUCT_PREBUILT_PATH := longan/out/$(TARGET_BOARD_IC)/$(PRODUCT_BOARD)/android
@@ -20,22 +20,59 @@
 
 PRODUCT_COPY_FILES += $(PRODUCT_PREBUILT_PATH)/bImage:kernel
 
+# ---- T95 H616 (файлы в apollo-t95/t95; до inherit-product: имеют приоритет над общими копиями) ----
+T95_DIR := $(PRODUCT_PLATFORM_PATH)/apollo-t95/t95
+PRODUCT_COPY_FILES += \
+    $(T95_DIR)/customer_ir_fe02.kl:system/usr/keylayout/customer_ir_fe02.kl \
+    $(T95_DIR)/homlet-default.json:$(TARGET_COPY_OUT_VENDOR)/etc/dispconfigs/homlet-default.json \
+    $(T95_DIR)/fd655.sh:$(TARGET_COPY_OUT_VENDOR)/bin/fd655.sh \
+    $(T95_DIR)/fd655.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/fd655.rc
+PRODUCT_PACKAGES += NetworkStackOverlayT95
+PRODUCT_PRODUCT_PROPERTIES += bluetooth.device.default_name=T95
+# T95: adb также по сети (порт 5555), КОГДА пользователь включает "Отладка по USB" (выкл по умолчанию, авторизация на экране:
+# ro.adb.secure=1). У T95 нет USB в режиме устройства (USB0 = host): без этого adb недоступен.
+PRODUCT_SYSTEM_PROPERTIES += service.adb.tcp.port=5555
+
+# приложения (apollo-t95/apps, оригинальные APK с подписью авторов): FLauncher как домашний экран вместо TvLauncher,
+# файловый менеджер Material Files, Cromite вместо WebView AOSP 91
+PRODUCT_PACKAGES += FLauncher MaterialFiles CromiteWebView SmartTube VLC Downloader FDroid
+# провайдеры WebView: Cromite + Google WebView (если установлен пользователем)
+PRODUCT_PACKAGE_OVERLAYS += $(PRODUCT_PLATFORM_PATH)/apollo-t95/overlay
+
+# убраны опасные или ненужные службы AW (механизм PackageOverride из device/softwinner/common/common.mk):
+#  preinstall  = тихо устанавливает каждый APK из /*/preinstall (и /sdcard/preinstall) при каждой загрузке
+#  preloaddata = копирует данные предустановленных приложений в /data от root при загрузке
+#  runin.sh    = заводской тест: выполняет через eval строки из /sdcard/runin_config от root при каждой загрузке
+#  appsdisable = отключает ресиверы BOOT_COMPLETED Google (нужно только с GApps)
+#  fix_traceing = chmod /sys/kernel/tracing "потому что на H618 SELinux выключен" (не нужно с enforcing)
+GLOBAL_REMOVED_PACKAGES += preinstall preloaddata runin.sh appsdisable fix_traceing
+
+# убранные приложения (ревизия 03.10.2026)
+#  заводские тесты/демо AW: Test_AD (демо AdManager: меняет логотип/анимацию загрузки), DragonBox, DragonAgingTV,
+#  DragonAtt, AwlogSettings; заменены: TvdFileManager (MaterialFiles), VideoPlayer (дубль TvdVideo);
+#  OTA-обновление AW: Update; бесполезны на ТВ: EasterEgg, Traceur, LiveTv, DeskClock, PhotoTable, WebScreensaver;
+#  телефонные: Contacts, Calendar, Camera2, Music, SoundRecorder, ExactCalculator, QuickSearchBox, SimAppDialog,
+#  WAPPushManager, NfcNci, SecureElement (нет NFC)
+#  оставлены: TvdVideo (аппаратное декодирование), GalleryTV/ImageParser, MiracastReceiver, TimerSwitch, BasicDreams,
+#  Browser2 (= оболочка WebView, единственный браузер для открытия ссылок)
+GLOBAL_REMOVED_PACKAGES += Test_AD DragonBox DragonAgingTV DragonAtt AwlogSettings TvdFileManager VideoPlayer Update \
+    EasterEgg Traceur LiveTv DeskClock PhotoTable WebScreensaver Contacts Calendar Camera2 Music SoundRecorder \
+    ExactCalculator QuickSearchBox SimAppDialog WAPPushManager NfcNci SecureElement
+
 #set speaker project(true: double speaker, false: single speaker)
 #set default eq
 PRODUCT_PROPERTY_OVERRIDES += \
     ro.vendor.spk_dul.used=false \
     ro.vendor.audio.eq=false
 
-PRODUCT_PACKAGES += DragonAtt
-PRODUCT_PACKAGES += SoundRecorder
 
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
-    persist.sys.timezone=Asia/Shanghai \
+    persist.sys.timezone=Europe/Rome \
     persist.sys.country=US \
     persist.sys.language=en
 
 PRODUCT_PROPERTY_OVERRIDES += \
-    ro.sf.lcd_density=160
+    ro.sf.lcd_density=180
 
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
     ro.minui.default_rotation=ROTATION_NONE \
