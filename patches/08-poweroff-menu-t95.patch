+<?xml version="1.0" encoding="utf-8"?>
+<!-- T95: значения framework (приоритет над device/softwinner/apollo/common/overlay) -->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <!-- долгое нажатие power (пульт): меню Выключить/Перезагрузить вместо немедленного выключения (у AW: 3).
+         Выключить = fake poweroff: BL31 уходит в standby, включение с пульта. -->
+    <integer name="config_longPressOnPowerBehavior">1</integer>
