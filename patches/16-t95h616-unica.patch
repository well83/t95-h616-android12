+/*
+ * T95: fdt_overlay_apply() изменяет dtbo, а при ошибке портит базовый fdt: применяем копию
+ * dtbo к копии fdt и записываем результат обратно только при успехе (при ошибке fdt остаётся
+ * прежним). Один и тот же dtbo (overlay PMIC из boot_package) применяется дважды: к fdt U-Boot
+ * здесь и к fdt ядра в sunxi_replace_fdt_v2(), которая заменяет working_fdt после board_init().
+ * Возвращает 0 = применён, 1 = не нужен (PMIC = pmu0 базового fdt), <0 = ошибка.
+ */
+int sunxi_overlay_apply_copy(void *fdt)
+{
+	u32 fdt_size, dtbo_size;
+	void *fdt_copy, *dtbo;
+	int ret;
+
+	if (!gd->new_dtbo || sunxi_overlay_apply_merged(fdt, gd->new_dtbo))
+		return 1;
+	fdt_size = fdt_totalsize(fdt);
+	dtbo_size = fdt_totalsize(gd->new_dtbo);
+	fdt_copy = malloc(fdt_size);
+	dtbo = malloc(dtbo_size);
+	if (!fdt_copy || !dtbo) {
+		free(fdt_copy);
+		free(dtbo);
+		return -1;
+	}
+	memcpy(fdt_copy, fdt, fdt_size);
+	memcpy(dtbo, gd->new_dtbo, dtbo_size);
+	ret = fdt_overlay_apply_verbose(fdt_copy, dtbo);
+	if (!ret)
+		memcpy(fdt, fdt_copy, fdt_size);
+	free(fdt_copy);
+	free(dtbo);
+	return ret ? -1 : 0;
+}
