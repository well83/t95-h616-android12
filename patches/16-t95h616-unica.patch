diff -ruN a/device/softwinner/apollo/apollo-t95h616/BoardConfig.mk b/device/softwinner/apollo/apollo-t95h616/BoardConfig.mk
--- a/device/softwinner/apollo/apollo-t95h616/BoardConfig.mk	1970-01-01 01:00:00.000000000 +0100
+++ b/device/softwinner/apollo/apollo-t95h616/BoardConfig.mk	2026-10-20 11:09:38.579038239 +0200
@@ -0,0 +1,31 @@
+include device/softwinner/common/BoardConfigCommon.mk
+
+include $(PRODUCT_PLATFORM_PATH)/BoardConfig.mk
+
+# must include common BoardConfig.mk in the end
+# T95: SELinux enforcing (строка AW "androidboot.selinux=permissive" убрана); правила T95 в t95-common/sepolicy (общие для обеих плат)
+BOARD_SEPOLICY_DIRS += $(PRODUCT_PLATFORM_PATH)/t95-common/sepolicy
+# правила сборщика логов t95log (работает только с T95_LOGGER=1, правила есть всегда)
+SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(PRODUCT_PLATFORM_PATH)/t95-common/t95log/sepolicy
+ifeq ($(T95_LOGGER),1)
+BOARD_KERNEL_CMDLINE += log_buf_len=2M
+endif
+BOARD_KERNEL_CMDLINE += androidboot.dtbo_idx=0,1,2
+BOARD_KERNEL_CMDLINE += firmware_class.path=/vendor/etc/firmware
+
+
+# wifi and bt configuration
+# 1. Wifi Configuration
+BOARD_WIFI_VENDOR := common
+BOARD_USR_WIFI    :=
+WIFI_DRIVER_MODULE_PATH :=
+WIFI_DRIVER_MODULE_NAME :=
+WIFI_DRIVER_MODULE_ARG  :=
+
+# 2. Bluetooth Configuration
+BOARD_BLUETOOTH_VENDOR    := common
+BOARD_HAVE_BLUETOOTH_NAME :=
+BOARD_BLUETOOTH_CONFIG_DIR :=  $(PRODUCT_PLATFORM_PATH)/common/wireless/bluetooth
+BOARD_BLUETOOTH_TTY := /dev/ttyAS1
+# Must include after wifi/bt configuration
+include device/softwinner/common/config/wireless/wireless_config.mk
