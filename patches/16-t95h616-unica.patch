+	if (get_boot_work_mode() == WORK_MODE_BOOT) {
+		int ret = sunxi_overlay_apply_copy(working_fdt);
+
+		pr_force("kernel fdt: %s\n", ret > 0 ? "not need merged sunxi overlay" :
+			 ret ? "sunxi overlay merged fail" : "sunxi overlay merged ok");
+	}
+#endif
 	return 0;
 }
 
