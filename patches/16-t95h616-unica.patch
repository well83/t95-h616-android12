--- a/device/softwinner/apollo/apollo-t95h616/camera/hawkview/sensor_list_cfg.ini	1970-01-01 01:00:00.000000000 +0100
+++ b/device/softwinner/apollo/apollo-t95h616/camera/hawkview/sensor_list_cfg.ini	2023-06-16 03:51:04.000000000 +0200
@@ -0,0 +1,108 @@
+#A100 sensor list configs
+#
+##################bus config######################
+#
+#used:                	0: not used, 	1: used;
+#csi_sel:              	0: mipi, 	    1:  parallel ;
+#device_sel:        	0: dev0, 	    1: dev1;
+#sensor_twi_id:twi id, for example: sensor_twi_id = 0
+#
+##################power configs###################
+#power_settings_enable: 0: enable the power settings in  sysconfig.fex;  1: enable the power settings in this file.
+#
+#iovdd                    The name of iovdd for this camera;
+#iovdd_vol                The voltage value of iovdd in uV;
+#
+###############detect sensor configs##############
+#
+#detect_sensor_num:    	  The number of sensors need be detected in this bus.
+#sensor_name[x]:          The sensor name in sensor driver.
+#sensor_twi_addr[x]:      The i2c address of this sensor.
+#sensor_type[x]:          The sensor type, 0: YUV, 1: RAW;
+#sensor_stby_mode[x]:  	  Not used;
+#sensor_hflip[x]          Horizontal flip;
+#sensor_vflip[x]          Vertical  flip;
+#act_name[x]              The VCM name in vcm driver, only RAW sensor need be configured;
+#act_twi_addr[x]          The i2c address of this VCM;
+#
+##################################################
+[rear_camera_cfg]
+
+#bus configs
+used                    = 1
+csi_sel                 = 0
+device_sel              = 0
+sensor_twi_id           = 0
+
+#power configs
+power_settings_enable   = 0
+iovdd                   = "iovdd-csi"
+iovdd_vol               = 2800000
+avdd                    = "avdd-csi"
+avdd_vol                = 2800000
+dvdd                    = "dvdd-csi"
+dvdd_vol                = 1800000
+afvdd                   = ""
+afvdd_vol               =
+
+#detect sensor configs
+detect_sensor_num       = 2
+
+sensor_name0            = "gc2385_mipi"
+sensor_twi_addr0        = 0x6e
+sensor_type0            = 1
+sensor_stby_mode0       = 0
+sensor_hflip0           = 1
+sensor_vflip0           = 1
+act_name0               =
+act_twi_addr0           =
+
+sensor_name1            = "gc2355_mipi"
+sensor_twi_addr1        = 0x78
+sensor_type1            = 1
+sensor_stby_mode1       = 0
+sensor_hflip1           = 1
+sensor_vflip1           = 1
+act_name1               =
+act_twi_addr1           =
+
+[front_camera_cfg]
+
+#bus configs
+used                    = 1
+csi_sel                 = 0
+device_sel              = 0
+sensor_twi_id           = 0
+
+#power configs
+power_settings_enable   = 0
+iovdd                   = "iovdd-csi"
+iovdd_vol               = 1800000
+avdd                    = "avdd-csi"
+avdd_vol                = 2800000
+dvdd                    = ""
+dvdd_vol                = 1800000
+afvdd                   = ""
+afvdd_vol               =
+
+
+#detect sensor configs
+detect_sensor_num       = 2
+
+sensor_name0            = "gc030a_mipi"
+sensor_twi_addr0        = 0x42
+sensor_type0            = 1
+sensor_stby_mode0       = 0
+sensor_hflip0           = 0
+sensor_vflip0           = 0
+act_name0               =
+act_twi_addr0           =
+
+sensor_name1            = "gc0310_mipi"
+sensor_twi_addr1        = 0x42
+sensor_type1            = 0
+sensor_stby_mode1       = 0
+sensor_hflip1           = 0
+sensor_vflip1           = 0
+act_name1               =
+act_twi_addr1           =
