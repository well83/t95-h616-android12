--- a/device/softwinner/apollo/apollo-t95/sepolicy/fd655.te	1970-01-01 01:00:00.000000000 +0100
+++ b/device/softwinner/apollo/apollo-t95/sepolicy/fd655.te	2026-10-03 14:26:53.060932148 +0200
@@ -0,0 +1,23 @@
+# T95: передний дисплей FD655 (часы), /vendor/bin/fd655.sh управляет PI11/PI12 через GPIO sysfs
+type fd655, domain;
+type fd655_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(fd655)
+
+allow fd655 vendor_shell_exec:file rx_file_perms;
+allow fd655 vendor_toolbox_exec:file rx_file_perms;
+
+# GPIO (export + direction/value для gpio267/268)
+allow fd655 sysfs_fd655_gpio:dir r_dir_perms;
+allow fd655 sysfs_fd655_gpio:file rw_file_perms;
+allow fd655 sysfs_fd655_gpio:lnk_file read;
+# экран вкл/выкл (/sys/class/disp/disp/attr/sys), значки LAN/WiFi/USB
+allow fd655 sysfs_disp:dir search;
+allow fd655 sysfs_disp:file r_file_perms;
+allow fd655 sysfs_net:dir r_dir_perms;
+allow fd655 sysfs_net:file r_file_perms;
+allow fd655 sysfs_block:dir r_dir_perms;
+allow fd655 sysfs:dir r_dir_perms;
+allow fd655 sysfs:file r_file_perms;
+allow fd655 sysfs:lnk_file read;
+# не даёт системе уснуть, пока экран включён
+wakelock_use(fd655)
