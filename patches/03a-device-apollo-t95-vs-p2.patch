+LOCAL_PREBUILT_JNI_LIBS := MaterialFiles/lib/arm64/libarchive-jni.so MaterialFiles/lib/arm64/libhiddenapi.so \
+    MaterialFiles/lib/arm64/libselinux-jni.so MaterialFiles/lib/arm64/libsyscall.so
+include $(BUILD_PREBUILT)
+
+# Cromite SystemWebView 153.0.8010.37 arm64 (com.android.webview, подпись CromiteOrg), sha256 dcb233a8...baa3
+# вместо WebView AOSP 91 (модуль "webview" из external/chromium-webview). Библиотеки не сжаты
+# (extractNativeLibs=false): загружаются прямо из APK.
+include $(CLEAR_VARS)
+LOCAL_MODULE := CromiteWebView
+LOCAL_MODULE_CLASS := APPS
