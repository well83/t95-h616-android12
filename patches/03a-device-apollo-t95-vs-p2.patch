+# GPIO sysfs (FD655: gpio267/268 в банке PI = gpiochip1)
+genfscon sysfs /class/gpio                                                     u:object_r:sysfs_fd655_gpio:s0
+genfscon sysfs /devices/platform/soc@3000000/300b000.pinctrl/gpiochip1/gpio     u:object_r:sysfs_fd655_gpio:s0
+# звуковые карты (id читают system_server и bootanimation)
+genfscon sysfs /devices/platform/soc@3000000/soc@3000000:codec_mach/sound       u:object_r:sysfs_t95_sound:s0
+genfscon sysfs /devices/platform/soc@3000000/soc@3000000:ahub1_mach/sound       u:object_r:sysfs_t95_sound:s0
+# extcon HDMI/TV (CEC и HWC)
+genfscon sysfs /devices/platform/soc@3000000/6520000.tv0/extcon                 u:object_r:sysfs_extcon:s0
+# источник пробуждения от пульта (system_suspend)
+genfscon sysfs /devices/platform/soc@3000000/7040000.s_cir/wakeup               u:object_r:sysfs_wakeup:s0
+# другие источники пробуждения (system_suspend читает статистику)
+genfscon sysfs /devices/platform/soc@3000000/5100000.udc-controller/wakeup      u:object_r:sysfs_wakeup:s0
+genfscon sysfs /devices/platform/soc@3000000/7000000.rtc/wakeup                 u:object_r:sysfs_wakeup:s0
+genfscon sysfs /devices/platform/soc@3000000/7081400.twi/i2c-5/5-0036/wakeup     u:object_r:sysfs_wakeup:s0
+genfscon sysfs /devices/platform/uwe_bsp.0/wakeup                               u:object_r:sysfs_wakeup:s0
+genfscon sysfs /devices/platform/soc@3000000/7000000.rtc/rtc/rtc0/wakeup         u:object_r:sysfs_wakeup:s0
