@@ -0,0 +1,51 @@
+# T95: недостающие правила, найденные на приставке (SELinux permissive, 03.10.2026), для перехода на enforcing
+
+vendor_internal_prop(vendor_t95_wifi_prop)
+vendor_internal_prop(vendor_t95_hwc_prop)
+vendor_internal_prop(vendor_t95_bt_prop)
+set_prop(hal_wifi_default, vendor_t95_wifi_prop)
+set_prop(hal_graphics_composer_default, vendor_t95_hwc_prop)
+get_prop(hal_tv_cec_default, vendor_t95_hwc_prop)
+get_prop(hal_awdisplayoutput_default, vendor_t95_hwc_prop)
+set_prop(hal_bluetooth_default, vendor_t95_bt_prop)
+set_prop(hal_bluetooth_default, vendor_wireless_prop)
+set_prop(hal_audio_default, vendor_audio_prop)
+
+# HAL CEC и HWC: состояние HDMI через extcon
+allow hal_tv_cec_default sysfs_extcon:dir r_dir_perms;
+allow hal_tv_cec_default sysfs_extcon:file r_file_perms;
+allow hal_graphics_composer_default sysfs_extcon:dir r_dir_perms;
+allow hal_graphics_composer_default sysfs_extcon:file r_file_perms;
+
+# WiFi HAL смотрит /data/misc/wifi (системные данные: AOSP запрещает vendor)
+dontaudit hal_wifi_default wifi_data_file:dir search;
+
+# id звуковых карт
+allow system_server sysfs_t95_sound:dir r_dir_perms;
+allow system_server sysfs_t95_sound:file r_file_perms;
+allow hal_audio_default sysfs_t95_sound:dir r_dir_perms;
+allow hal_audio_default sysfs_t95_sound:file r_file_perms;
+allow bootanim sysfs_t95_sound:dir r_dir_perms;
+allow bootanim sysfs_t95_sound:file r_file_perms;
+
+# system_suspend (приватный системный тип) уже читает sysfs_wakeup: достаточно метки в genfs_contexts
+
+# HAL видеовыхода AW, вызывается из system_server
+hal_client_domain(system_server, hal_awdisplayoutput)
+
+# pqd: /data/disp_firmware (копия для настройки PQ с ПК) запрещена vendor; используется /vendor/etc/firmware
+dontaudit pqd system_data_root_file:file { rw_file_perms map };
+dontaudit pqd system_data_root_file:dir { write add_name };
+
+# vendor_init: dirty_expire_centisecs, /data/audio_d
+allow vendor_init proc_dirty:file w_file_perms;
+dontaudit vendor_init audio_rw_data_file:dir { getattr create };
+
+# безвредный шум
+dontaudit bootanim cache_file:lnk_file read;
+dontaudit bootanim system_data_file:dir search;
+dontaudit surfaceflinger hal_graphics_composer_default:dir search;
+dontaudit surfaceflinger hal_graphics_composer_default:file r_file_perms;
+
+# HAL CEC читает hdmi.cec.debug каждые 2 с: теперь с меткой vendor_t95_hwc_prop (property_contexts), get_prop выше
+# FLauncher (Flutter) читает /proc/sys/vm/max_map_count: AOSP запрещает приложениям, безвредно -> оставлено
