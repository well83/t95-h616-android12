--- a/device/softwinner/apollo/apollo-t95/t95/fd655.sh	1970-01-01 01:00:00.000000000 +0100
+++ b/device/softwinner/apollo/apollo-t95/t95/fd655.sh	2026-10-03 14:28:14.661292860 +0200
@@ -0,0 +1,61 @@
+#!/vendor/bin/sh
+# Передний дисплей T95 (FD655) через GPIO sysfs: протокол восстановлен по драйверу стокового ядра 4.9
+# (FD655_Start/Writebyte/Stop/Command/Disp). CLK = PI11 (gpio 267), DAT = PI12 (gpio 268).
+#  команда:  START 0x48 <cmd> STOP         (0x03 = дисплей вкл, 0x00 = выкл)
+#  цифры:    START <0x68|0x6a|0x6c|0x6e> <сегменты> STOP ; значки: START 0x66 <маска> STOP
+#  значки (бит): 0 часы, 1 USB, 2 play, 3 пауза, 4 двоеточие, 5 LAN, 6 WiFi
+# использование: fd655.sh text "1234" [значки] | fd655.sh clock (служба) | fd655.sh off
+# служба:   /vendor/etc/init/fd655.rc -> /vendor/bin/fd655.sh clock
+#           домен SELinux fd655 (apollo-t95/sepolicy/fd655.te): только GPIO, sysfs и wakelock
+#           сетевое имя DHCP: overlay NetworkStackOverlayT95; имя Bluetooth: bluetooth.device.default_name
+#           (патч btif_dm.cc); анимация FLauncher выключена по умолчанию (патч 06)
+CLK=267; DAT=268; G=/sys/class/gpio
+for p in $CLK $DAT; do
+  [ -d $G/gpio$p ] || echo $p > $G/export
+  echo out > $G/gpio$p/direction
+done
+exec 3>$G/gpio$CLK/value 4>$G/gpio$DAT/value
+c() { echo $1 >&3; }
+d() { echo $1 >&4; }
+start() { d 1; c 1; d 0; c 0; }
+stop()  { d 0; c 1; d 1; }
+wbyte() { v=$1; i=8
+  while [ $i -gt 0 ]; do
+    if [ $((v & 128)) -ne 0 ]; then d 1; else d 0; fi
+    c 1; c 0; v=$(( (v << 1) & 255 )); i=$((i - 1))
+  done
+  d 1; c 1; c 0; }                       # такт для ACK
+send() { start; wbyte $1; wbyte $2; stop; }
+# таблица сегментов из стокового драйвера (нестандартная разводка T95)
+seg() { case "$1" in
+  0|O|o) echo 63;; 1) echo 48;; 2) echo 91;; 3) echo 121;; 4) echo 116;; 5) echo 109;; 6) echo 111;; 7) echo 56;;
+  8) echo 127;; 9) echo 125;; a|A) echo 119;; b|B) echo 103;; c) echo 88;; C) echo 57;; d|D) echo 94;;
+  e|E) echo 121;; f|F) echo 113;; t|T) echo 71;; *) echo 0;; esac; }
+text() { s="$1"; n=0
+  for a in 104 106 108 110; do ch=${s:$n:1}; send $a $(seg "$ch"); n=$((n + 1)); done
+  send 102 ${2:-0}; }
+icons() { m=16                            # двоеточие всегда горит
+  [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" = 1 ] && m=$((m | 32))
+  [ "$(cat /sys/class/net/wlan0/operstate 2>/dev/null)" = up ] && m=$((m | 64))
+  ls -d /sys/class/block/sd? >/dev/null 2>&1 && m=$((m | 2))
+  echo $m; }
+# экран включён = выход HDMI активен: в standby строка "unblank" пропадает (проверено 03.10)
+awake() { grep -q unblank /sys/class/disp/disp/attr/sys; }
+case "$1" in
+  text) send 72 3; text "$2" "$3";;
+  off) send 72 0;;
+  clock) on=
+    while :; do
+      if awake; then
+        # wakelock, пока экран включён: без него Android уходит в глубокий сон через мгновение после
+        # выключения экрана, раньше чем цикл это заметит, и дисплей остаётся гореть в standby
+        [ -z "$on" ] && { echo fd655 > /sys/power/wake_lock; send 72 3; on=1; old=; }
+        cur="$(date +%H%M) $(icons)"
+        [ "$cur" != "$old" ] && { text ${cur% *} ${cur#* }; old=$cur; }
+      elif [ -n "$on" ]; then
+        send 72 0; on=                    # standby: дисплей выкл, затем разрешаем сон
+        echo fd655 > /sys/power/wake_unlock
+      fi
+      sleep 3
+    done;;
+esac
