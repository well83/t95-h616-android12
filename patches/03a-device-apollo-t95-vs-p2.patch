+LOCAL_SRC_FILES := CromiteWebView/CromiteWebView.apk
+LOCAL_REPLACE_PREBUILT_APK_INSTALLED := $(LOCAL_PATH)/CromiteWebView/CromiteWebView.apk
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_PRODUCT_MODULE := true
+LOCAL_DEX_PREOPT := false
+LOCAL_ENFORCE_USES_LIBRARIES := false
+LOCAL_OVERRIDES_PACKAGES := webview
+LOCAL_REQUIRED_MODULES := libwebviewchromium_loader libwebviewchromium_plat_support
+include $(BUILD_PREBUILT)
+
+# SmartTube 32.56 stable arm64 (org.smarttube.stable, подпись "Yurii L" 109735aa...), sha256 cc53f1ae...c864
+include $(CLEAR_VARS)
+LOCAL_MODULE := SmartTube
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_SUFFIX := .apk
+LOCAL_SRC_FILES := SmartTube/SmartTube.apk
+LOCAL_REPLACE_PREBUILT_APK_INSTALLED := $(LOCAL_PATH)/SmartTube/SmartTube.apk
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_PRODUCT_MODULE := true
+LOCAL_DEX_PREOPT := false
+LOCAL_ENFORCE_USES_LIBRARIES := false
+LOCAL_MULTILIB := 64
+LOCAL_PREBUILT_JNI_LIBS := SmartTube/lib/arm64/libconscrypt_jni.so SmartTube/lib/arm64/libcronet.105.0.5195.68.so \
+    SmartTube/lib/arm64/libglide-webp.so SmartTube/lib/arm64/libj2v8.so
+include $(BUILD_PREBUILT)
+
+# VLC 3.7.1 arm64 (org.videolan.vlc, подпись VideoLAN c8768d2c...), sha256 bea9ea0c...de74 (= официальный .sha256)
+include $(CLEAR_VARS)
+LOCAL_MODULE := VLC
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_SUFFIX := .apk
+LOCAL_SRC_FILES := VLC/VLC.apk
+LOCAL_REPLACE_PREBUILT_APK_INSTALLED := $(LOCAL_PATH)/VLC/VLC.apk
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_PRODUCT_MODULE := true
+LOCAL_DEX_PREOPT := false
+LOCAL_ENFORCE_USES_LIBRARIES := false
+LOCAL_MULTILIB := 64
+LOCAL_PREBUILT_JNI_LIBS := VLC/lib/arm64/libc++_shared.so VLC/lib/arm64/libmla.so VLC/lib/arm64/libvlc.so \
+    VLC/lib/arm64/libvlcjni.so
+include $(BUILD_PREBUILT)
+
+# Downloader by AFTVnews 2.0.4 (com.esaba.downloader, бандл Play с APKMirror, подпись bf2d3029...; содержит
+# рекламу AdMob/Meta). Разделённое приложение: base + split arm64/it/en/mdpi/hdpi в одной папке (библиотеки
+# не сжаты, в split arm64). Обновляется через Aurora Store.
+DOWNLOADER_SPLITS := split_config.arm64_v8a split_config.it split_config.en split_config.mdpi split_config.hdpi
+include $(CLEAR_VARS)
+LOCAL_MODULE := Downloader
