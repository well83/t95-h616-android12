+# T95, тестовые сборки: /system_ext/bin/t95log.sh собирает dmesg/logcat/info в /data/misc/t95log и /sdcard/T95_LOG
+type t95log, domain, coredomain;
+type t95log_exec, exec_type, system_file_type, file_type;
+type t95log_data_file, file_type, data_file_type, core_data_file_type;
+init_daemon_domain(t95log)
+
+allow t95log shell_exec:file rx_file_perms;
+allow t95log toolbox_exec:file rx_file_perms;
+allow t95log system_file:file rx_file_perms;
+
+allow t95log self:global_capability2_class_set syslog;
+
+# работает как media_rw (владелец /data/media/0): без dac_override; dmesg через CAP_SYSLOG
+allow t95log kernel:system syslog_read;
+# logcat
+read_logd(t95log)
+
+# getprop: читает что может, не засоряя лог отказами
+dontaudit t95log property_type:file r_file_perms;
+
+# /data/misc/t95log
+allow t95log system_data_file:dir r_dir_perms;
+allow t95log t95log_data_file:dir create_dir_perms;
+allow t95log t95log_data_file:file create_file_perms;
+# /sdcard/T95_LOG (= /data/media/0)
+allow t95log media_rw_data_file:dir create_dir_perms;
+allow t95log media_rw_data_file:file create_file_perms;
+
+# информация о системе
+allow t95log { proc_cmdline proc_version proc_meminfo proc_cpuinfo proc_modules proc_interrupts proc_uptime }:file r_file_perms;
+allow t95log sysfs:dir r_dir_perms;
+allow t95log sysfs:lnk_file read;
+allow t95log sysfs_devices_system_cpu:dir r_dir_perms;
+allow t95log sysfs_devices_system_cpu:file r_file_perms;
+allow t95log sysfs_thermal:dir r_dir_perms;
+allow t95log sysfs_thermal:{ file lnk_file } r_file_perms;
+allow t95log sysfs_net:dir r_dir_perms;
+allow t95log sysfs_net:{ file lnk_file } r_file_perms;
