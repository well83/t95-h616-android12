+# T95, тестовые сборки: логи в файлы (см. /system_ext/bin/t95log.sh)
+# не oneshot: если процесс убит, init перезапустит его (скрипт продолжит в той же папке boot_NNN)
+on post-fs-data
+    mkdir /data/misc/t95log 0770 media_rw media_rw
+    start t95log
+
+service t95log /system_ext/bin/t95log.sh
+    user media_rw
+    group media_rw log readproc
+    capabilities SYSLOG
+    disabled
+
--- a/device/softwinner/apollo/apollo-t95/t95log/t95log.sh	1970-01-01 01:00:00.000000000 +0100
+++ b/device/softwinner/apollo/apollo-t95/t95log/t95log.sh	2026-10-18 11:15:25.724464329 +0200
@@ -0,0 +1,80 @@
+#!/system/bin/sh
+# T95, тестовые сборки: собирает лог ядра (dmesg = то, что идёт в UART после U-Boot) + logcat + информацию о системе.
+# Во время загрузки пишет в /data/misc/t95log/boot_NN (сохраняется, даже если загрузка не дошла до конца: копируется при следующей);
+# как только память пользователя разблокирована, копирует всё в /sdcard/T95_LOG (Material Files -> T95_LOG, для отправки).
+B=/data/misc/t95log
+OUT=/data/media/0/T95_LOG
+KEEP=6
+
+# удаляет самые старые папки boot_*, оставляя $KEEP
+prune() {
+  n=$(ls -d $1/boot_[0-9]* 2>/dev/null | wc -l)
+  for o in $(ls -d $1/boot_[0-9]* 2>/dev/null | sort); do
+    [ $n -le $KEEP ] && break
+    rm -rf $o; n=$(( n - 1 ))
+  done
+}
+
+# одна папка на всю загрузку, даже если init перезапускает сервис (boot_id меняется только при загрузке)
+BID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
+if [ -n "$BID" ] && [ "$BID" = "$(cat $B/boot_id 2>/dev/null)" ] && [ -d "$(cat $B/current 2>/dev/null)" ]; then
+  D=$(cat $B/current)
+else
+  N=$(cat $B/counter 2>/dev/null); N=$(( ${N:-0} + 1 )); echo $N > $B/counter
+  D=$B/$(printf boot_%03d $N)
+  mkdir -p $D
+  echo "$BID" > $B/boot_id; echo $D > $B/current
+fi
+# ошибки команд + строка на каждый проход (чтобы понять, остановился ли сборщик и когда)
+exec 2>>$D/t95log_err.txt
+echo "=== start pid $$ uptime $(cat /proc/uptime)" >&2
+# хранит только последние $KEEP загрузок
+prune $B
+
+info() {
+  # NB: здесь без глобальных переменных (с "t" основной цикл умирал после первого прохода)
+  echo "=== date";        date
+  echo "=== uptime";      cat /proc/uptime
+  echo "=== cmdline";     cat /proc/cmdline
+  echo "=== version";     cat /proc/version
+  echo "=== meminfo";     cat /proc/meminfo
+  echo "=== cpuinfo";     cat /proc/cpuinfo
+  echo "=== cpufreq"
+  for c in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
+    echo "$c: cur=$(cat $c/scaling_cur_freq) min=$(cat $c/scaling_min_freq) max=$(cat $c/scaling_max_freq) avail=$(cat $c/scaling_available_frequencies)"
+  done
+  echo "=== thermal";     for z in /sys/class/thermal/thermal_zone*; do echo "$z $(cat $z/type) $(cat $z/temp)"; done
+  ls -lZ /sys/class/thermal/thermal_zone0/
+  echo "=== modules";     cat /proc/modules
+  echo "=== interrupts";  cat /proc/interrupts
+  echo "=== sdio/mmc";    ls -l /sys/bus/sdio/devices /sys/bus/mmc/devices
+  echo "=== net";         for n in /sys/class/net/*; do echo "$n $(cat $n/address) $(cat $n/operstate)"; done
+  echo "=== getprop";     getprop
+}
+
+snap() {
+  dmesg > $D/dmesg.txt.new 2>&1 && mv $D/dmesg.txt.new $D/dmesg.txt
+  logcat -d -b all -v threadtime > $D/logcat.txt.new 2>&1 && mv $D/logcat.txt.new $D/logcat.txt
+  info > $D/info.txt.new 2>&1 && mv $D/info.txt.new $D/info.txt
+  sync
+  # память пользователя разблокирована (с FBE до разблокировки имена зашифрованы и папки Download нет)
+  echo "snap uptime $(cat /proc/uptime)" >&2
+  if [ -d /data/media/0/Download ]; then
+    mkdir -p $OUT
+    for b in $B/boot_[0-9]*; do
+      mkdir -p $OUT/${b##*/}
+      cp $b/*.txt $OUT/${b##*/}/
+    done
+    prune $OUT
+    echo "T95 log: una cartella per avvio (boot_NNN, la piu' alta = ultimo avvio). dmesg = kernel, logcat = Android, info = sistema." > $OUT/LEGGIMI.txt
+    chmod -R ug+rwX,o-rwx $OUT
+  fi
+}
+
+# первые 3 минуты каждые 15 с, до 30 минут каждые 2 минуты, дальше каждые 10 минут
+t=0
+while true; do
+  snap
+  if [ $t -lt 180 ]; then s=15; elif [ $t -lt 1800 ]; then s=120; else s=600; fi
+  sleep $s; t=$(( t + s ))
+done
