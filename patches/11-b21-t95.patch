+     кадры (обе платы, AXP806 и AXP313). 0 убирает их полностью, но слишком резко; 0,5x — компромисс.
+     Обе настройки можно изменить в «Для разработчиков». -->
+<resources>
+    <fraction name="def_window_animation_scale">50%</fraction>
+    <fraction name="def_window_transition_scale">50%</fraction>
+</resources>
